# AssetVal Pro production API
DATABASE_URL=postgresql://assetval:CHANGE_ME@localhost:5432/assetval
PORT=8080

# OIDC / OAuth2
OIDC_REQUIRED=true
OIDC_ISSUER=https://your-identity-provider.example.com
OIDC_AUDIENCE=assetval-pro-api
OIDC_JWKS_URL=https://your-identity-provider.example.com/.well-known/jwks.json

# The authenticated web/mobile clients send:
# Authorization: Bearer <short-lived-access-token>
